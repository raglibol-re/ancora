{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!dev-dist", "!public/brand"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"domains": { "playwright": "none" },
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"performance": {
				"noBarrelFile": "error",
				"noReExportAll": "error"
			},
			"style": {
				"noNonNullAssertion": "error",
				"useImportType": "error"
			},
			"suspicious": {
				"noConsole": "error",
				"noExplicitAny": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"overrides": [
		{
			"includes": ["api/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": { "level": "error", "options": { "allow": ["error"] } }
					}
				}
			}
		},
		{
			"includes": ["e2e/**", "playwright.config.ts"],
			"linter": { "domains": { "playwright": "recommended" } }
		},
		{
			"includes": ["package.json"],
			"formatter": { "indentStyle": "space", "indentWidth": 2 }
		}
	],
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
