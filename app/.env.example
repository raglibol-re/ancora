# Copy to .env.local for local development. Real values live in Vercel environment variables.
# Variables prefixed with VITE_ are bundled into the client and must never hold secrets.

# Client (public): generated into .env.testnet by scripts/setup-testnet.sh; no need to set by hand.
# See app/.env.testnet for the full list (network, contract IDs, VITE_RELAYER_URL=/api/relay).

# Server (Vercel Functions in api/): set by `scripts/setup-testnet.sh --sync-vercel`.
# For local `vercel dev`, put them in .env.local (gitignored).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ACCOUNT_WASM_HASH=1b5f4534a76322da2ad7c745f6900857a6802b0ca79850c35a03561df997785a
USDC_TOKEN=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Secret: the demo operator key (pays sponsored fees, sends test money; never a signer on org accounts).
DEPLOYER_SECRET=
# Secret: gates /admin and /api/admin. The setup script generates one and saves it to .env.local.
ADMIN_PASSPHRASE=
# Set automatically by the Vercel Blob store "ancora" (site-wide demo mode, later logos).
BLOB_READ_WRITE_TOKEN=
