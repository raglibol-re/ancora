# Copy to .env.local for local development. Real values live in Vercel environment variables.
# Variables prefixed with VITE_ are bundled into the client and must never hold secrets.

# Client (public): generated into .env.testnet by scripts/setup-testnet.sh; no need to set by hand.
# See app/.env.testnet for the full list (network, contract IDs, VITE_RELAYER_URL=/api/relay).
# VITE_ANCHOR_HOME_DOMAIN names the SEP-24 anchor for bank deposits and withdrawals (default testanchor.stellar.org).
# VITE_FX_RATES_URL is the exchange-rate service for the headline total only (default https://api.frankfurter.app).

# Server (Vercel Functions in api/): set by `scripts/setup-testnet.sh --sync-vercel`.
# For local `vercel dev`, put them in .env.local (gitignored).
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
ACCOUNT_WASM_HASH=1b5f4534a76322da2ad7c745f6900857a6802b0ca79850c35a03561df997785a
USDC_TOKEN=CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU
# ancora's own contracts (set by the script after `stellar contract build`): the organization WASM the
# operator deploys per organization, and the one registry (profiles, memberships).
ORG_WASM_HASH=a4f6cb253c9a0c41b22b683a195598298f37aeb041570b2b6b6dac57e8423042
REGISTRY_CONTRACT=CDPQV7C2XRWVDGWBIEHNE6IOMC56KSAITMESJBI7BULJSIGSVAQD4QCM
# ancora's ML-DSA-44 seal verifier (deployed once by the script; the client gets VITE_SEAL_VERIFIER).
SEAL_VERIFIER=
# ancora's Lifeline recovery contract (deployed once by the script; the client gets VITE_RECOVERY_CONTRACT).
RECOVERY_CONTRACT=
# The stablecoins an organization may accept (Symbol:contract:currency[:DeFindex vault]); the client gets VITE_ORG_ASSETS.
ORG_ASSETS=BlendUSDC:CAQCFVLOBK5GIULPNZRGATJJMIZL5BSP7X5YJVMGCPTUEPFM4AVSRCJU:USD:CBMVK2JK6NTOT2O4HNQAIQFJY232BHKGLIMXDVQVHIIZKDACXDFZDWHN,USDC:CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA:USD,EURC:CCUUDM434BMZMYWYDITHFXHDMIVTGGD6T2I5UKNX5BSLXLW7HVR4MCGZ:EUR
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Secret: the demo operator key (pays sponsored fees, sends test money; never a signer on org accounts).
DEPLOYER_SECRET=
# Secret: gates /admin and /api/admin. The setup script generates one and saves it to .env.local.
ADMIN_PASSPHRASE=
# Set automatically by the Vercel Blob store "ancora" (site-wide demo mode, profile pictures, later logos).
BLOB_READ_WRITE_TOKEN=
